# Copy to .env and fill in. Never commit .env.
# Values marked "(phase N)" are read once that phase is implemented.

# ---------- Backend: runtime ----------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Public URL of the frontend (used in emails and as the default CORS origin)
APP_URL=http://localhost:5173
# Extra allowed CORS origins, comma-separated (optional)
CORS_ORIGINS=
# Number of reverse proxies in front of the API (1 behind Nginx in production)
TRUST_PROXY=0

# ---------- Docker Compose host ports ----------
# Ports published on your machine. Change one if it's already taken (e.g. a Redis
# running in WSL on 6379). Containers reach each other internally, so this only
# affects tools on the host.
MONGO_HOST_PORT=27017
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=4000
FRONTEND_HOST_PORT=5173

# ---------- Data stores ----------
# Local (non-Docker) dev against the Compose Mongo needs directConnection=true,
# because the replica-set member advertises the Docker hostname "mongo".
MONGO_URI=mongodb://localhost:27017/fitgeng?directConnection=true
# Leave empty to run without Redis (cache/rate limits fall back gracefully)
REDIS_URL=redis://localhost:6379

# ---------- Auth (phase 2) ----------
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Seeded platform admin (phase 2)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---------- Email (phase 2) ----------
# "log" prints emails to the console; "sendgrid" sends them.
EMAIL_PROVIDER=log
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@fitgeng.com
EMAIL_FROM_NAME=FitGeng

# ---------- File storage (phase 3a) ----------
# "local" (dev) or "cloudinary" (production)
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=fitgeng

# ---------- Branding (backend: emails) ----------
BRAND_NAME=
BRAND_SUPPORT_EMAIL=

# ---------- Frontend (public, bundled into the client: no secrets) ----------
VITE_API_BASE_URL=/api/v1
VITE_BRAND_NAME=
VITE_BRAND_TAGLINE=
VITE_BRAND_SUPPORT_EMAIL=
VITE_BRAND_PRIMARY_COLOR=
VITE_BRAND_ACCENT_COLOR=
VITE_BRAND_LOGO_URL=
# Where the Vite dev server proxies /api (Compose sets this to http://backend:4000)
API_PROXY_TARGET=http://localhost:4000
