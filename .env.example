# Copy to .env and fill in. Never commit .env.
# Values marked "(phase N)" are read once that phase is implemented.

# ---------- Backend: runtime ----------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Public URL of the frontend (used in emails and as the default CORS origin)
APP_URL=http://localhost:3000
# Extra allowed CORS origins, comma-separated (optional)
CORS_ORIGINS=
# Number of reverse proxies in front of the API (1 behind Nginx in production)
TRUST_PROXY=0

# ---------- Docker Compose host ports ----------
# Ports published on your machine. Change one if it's already taken (e.g. a Redis
# running in WSL on 6379). Containers reach each other internally, so this only
# affects tools on the host.
MONGO_HOST_PORT=27017
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=4000
FRONTEND_HOST_PORT=3000

# ---------- Data stores ----------
# Local (non-Docker) dev against the Compose Mongo needs directConnection=true,
# because the replica-set member advertises the Docker hostname "mongo".
MONGO_URI=mongodb://localhost:27017/fitgeng?directConnection=true
# Leave empty to run without Redis (cache/rate limits fall back gracefully)
REDIS_URL=redis://localhost:6379

# ---------- Auth ----------
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Requests per 15 minutes per IP on login, register and email-sending endpoints
AUTH_RATE_LIMIT=20
# Seeded platform admin (phase 2)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---------- Email ----------
# "log" prints emails (with their links) to the backend console; "sendgrid" sends them.
# Production requires sendgrid.
EMAIL_PROVIDER=log
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@fitgeng.com
EMAIL_FROM_NAME=FitGeng

# ---------- File storage (phase 3a) ----------
# "local" (dev) or "cloudinary" (production)
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=fitgeng

# ---------- Branding (backend: emails) ----------
BRAND_NAME=
BRAND_SUPPORT_EMAIL=

# ---------- Frontend: public (inlined into browser code at build time: no secrets) ----------
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Canonical public origin for SEO metadata, canonical URLs and the sitemap.
# Set it to the real domain in production (e.g. https://fitgeng.com) BEFORE building.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google Search Console "HTML tag" verification token (content value only). Read at build time.
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_BRAND_TAGLINE=
NEXT_PUBLIC_BRAND_DESCRIPTION=
NEXT_PUBLIC_BRAND_SUPPORT_EMAIL=
# Colours: defaults live in packages/shared/src/theme.ts; these override brand/accent (#rrggbb)
NEXT_PUBLIC_BRAND_PRIMARY_COLOR=
NEXT_PUBLIC_BRAND_ACCENT_COLOR=
NEXT_PUBLIC_BRAND_LOGO_URL=

# ---------- Frontend: server-only ----------
# Express API as reached from the Next.js server (session checks, server-side data).
# Compose sets http://backend:4000/api/v1. Never exposed to browsers.
INTERNAL_API_URL=http://localhost:4000/api/v1
# Dev only: where `next dev` proxies /api. Compose sets http://backend:4000.
# Leave unset for production builds (Nginx routes /api instead).
API_PROXY_TARGET=http://localhost:4000
